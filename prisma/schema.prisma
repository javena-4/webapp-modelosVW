generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  carSlug   String
  carName   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}
