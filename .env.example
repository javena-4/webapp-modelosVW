# Copiá este archivo:
#   copy .env.example .env
#   copy .env.example .env.local
# y completá los secretos en .env.local

# Postgres (Neon free). En Neon usá la URL "pooled" (host con -pooler) para Vercel.
# Ejemplo: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# false en localhost; true en Vercel/producción
COOKIE_SECURE="false"

# --- Poner en .env.local (no commitear) ---
ADMIN_EMAIL="tu-email@ejemplo.com"
ADMIN_PASSWORD="tu-password-segura"
SESSION_SECRET="genera-un-secreto-largo-y-aleatorio"

# Opcional para e2e (default: http://localhost:3000)
# PLAYWRIGHT_BASE_URL="http://localhost:3000"
